rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function verified(){return request.auth != null && request.auth.token.email_verified == true;}
  function admin(){return verified() && (request.auth.token.email.lower() == 'mike@options-abc.com' || staffRole() == 'admin');}
  function staffRole(){return verified() && exists(/databases/$(database)/documents/staff/$(request.auth.token.email.lower())) ? get(/databases/$(database)/documents/staff/$(request.auth.token.email.lower())).data.role : '';}
  function editor(kind){return admin() || (kind == 'specials' && staffRole() == 'chef') || (kind == 'notes' && staffRole() == 'commodore') || (kind == 'events' && staffRole() == 'events');}
  function valid(x,kind){return x.keys().hasAll(['title','body','startDate','endDate','time','durationMinutes','price','location','author','category','status','createdAt','updatedAt']) && x.keys().hasOnly(['title','body','startDate','endDate','time','durationMinutes','price','location','author','category','status','createdAt','updatedAt'])
   && x.title is string && x.title.size()>0 && x.title.size()<=120 && x.body is string && x.body.size()>0 && x.body.size()<=5000
   && x.startDate is string && (x.startDate == '' || x.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
   && x.endDate is string && (x.endDate == '' || x.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
   && (x.startDate == '' || x.endDate == '' || x.endDate >= x.startDate)
   && x.time is string && (x.time == '' || x.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
   && x.durationMinutes is int && x.durationMinutes>=0 && x.durationMinutes<=1440
   && x.price is string && x.price.size()<=60 && x.location is string && x.location.size()<=240 && x.author is string && x.author.size()<=120
   && x.category in ['club','social','dining'] && x.status in ['draft','published','archived']
   && (x.status != 'published' || (x.startDate != '' && (kind != 'specials' || x.endDate != '') && (kind != 'events' || x.time != '')))
   && x.createdAt is timestamp && x.updatedAt == request.time;
  }
  match /staff/{email} {
   allow get: if admin() || (verified() && request.auth.token.email.lower() == email);
   allow list: if admin();
   allow create,update: if admin() && email != 'mike@options-abc.com' && email.matches('^[^/]+@[^/]+$') && request.resource.data.keys().hasOnly(['role','updatedAt']) && request.resource.data.role in ['admin','chef','commodore','events'] && request.resource.data.updatedAt == request.time;
   allow delete: if admin() && email != 'mike@options-abc.com';
  }
  match /content/{kind}/items/{id} {
   allow read: if resource.data.status == 'published' || editor(kind);
   allow create: if kind in ['specials','notes','events'] && editor(kind) && valid(request.resource.data,kind) && request.resource.data.createdAt == request.time;
   allow update: if kind in ['specials','notes','events'] && editor(kind) && valid(request.resource.data,kind) && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if false;
  }

  function eventOrganizer(){return admin() || staffRole() == 'events';}
  function membership(){return verified() && exists(/databases/$(database)/documents/rosterEmails/$(request.auth.token.email.lower()))
   && get(/databases/$(database)/documents/members/$(get(/databases/$(database)/documents/rosterEmails/$(request.auth.token.email.lower())).data.memberId)).data.active == true
   && get(/databases/$(database)/documents/members/$(get(/databases/$(database)/documents/rosterEmails/$(request.auth.token.email.lower())).data.memberId)).data.email == request.auth.token.email.lower();}
  function responseKey(){return get(/databases/$(database)/documents/members/$(get(/databases/$(database)/documents/rosterEmails/$(request.auth.token.email.lower())).data.memberId)).data.rsvpKey;}
  match /members/{memberId} {
   allow get: if eventOrganizer() || (membership() && resource.data.email == request.auth.token.email.lower());
   allow list: if eventOrganizer();
   allow create, update: if admin() && request.resource.data.keys().hasAll(['memberId','email','name','contactJSON','active','rsvpKey','updatedAt']) && request.resource.data.keys().hasOnly(['memberId','email','name','contactJSON','active','rsvpKey','updatedAt'])
    && request.resource.data.memberId == memberId && memberId.matches('^[A-Za-z0-9_-]{1,80}$')
    && request.resource.data.email is string && request.resource.data.email.size() <= 254 && request.resource.data.email.matches('^[^/@ ]+@[^/@ ]+$') && request.resource.data.email == request.resource.data.email.lower()
    && request.resource.data.name is string && request.resource.data.name.size() <= 300
    && request.resource.data.contactJSON is string && request.resource.data.contactJSON.size() <= 20000
    && request.resource.data.rsvpKey is string && request.resource.data.rsvpKey.size() > 0 && request.resource.data.rsvpKey.size() <= 80
    && request.resource.data.active is bool && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  match /rosterEmails/{email} {
   allow get: if eventOrganizer() || (verified() && request.auth.token.email.lower() == email);
   allow list: if admin();
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['memberId']) && request.resource.data.memberId is string
    && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.email == email;
   allow delete: if admin();
  }
  match /memberBindings/{uid} {
   allow get: if eventOrganizer() || (verified() && membership() && responseKey() == uid);
   allow list: if eventOrganizer();
   allow create,update: if membership() && membership() && responseKey() == uid && request.resource.data.keys().hasOnly(['email','memberId'])
    && request.resource.data.email == request.auth.token.email.lower()
    && request.resource.data.memberId == get(/databases/$(database)/documents/rosterEmails/$(request.auth.token.email.lower())).data.memberId;
   allow delete: if false;
  }
  match /content/events/items/{eventId}/responses/{uid} {
   // Opaque stable membership keys, status and timestamp; no contact details.
   allow read: if membership() || eventOrganizer();
   allow create,update: if membership() && membership() && responseKey() == uid
    && get(/databases/$(database)/documents/content/events/items/$(eventId)).data.status == 'published'
    && request.resource.data.keys().hasAll(['status','updatedAt']) && request.resource.data.keys().hasOnly(['status','updatedAt'])
    && request.resource.data.status in ['going','interested','not-going'] && request.resource.data.updatedAt == request.time;
   allow delete: if verified() && membership() && responseKey() == uid;
  }
  match /{document=**}{allow read,write: if false;}
 }
}
